APP_NAME="Stelfaro Platform API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://platform.stelfaro.com
APP_PORTAL_HOST=platform.stelfaro.com
APP_PORTAL_SCHEME=https

APP_LOCALE=es_SV
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US
VITE_STELFARO_DEMO_VIDEO_ID=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=stelfaro_platform
DB_USERNAME=stelfaro_platform
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=45
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.stelfaro.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DTE_CORE_BASE_URL=http://127.0.0.1:8181/api/v1
DTE_CORE_TOKEN=
DTE_CORE_ADMIN_EMAIL=admin@stelfaro.com
DTE_CORE_ADMIN_DEVICE_NAME=stelfaro-platform-admin

PLATFORM_ADMIN_EMAILS=
PLATFORM_FISCAL_ADMIN_EMAILS=

NOTIFICATIONS_BASE_URL=https://admin.stelfaro.com/notifications-api/v1
NOTIFICATIONS_INTERNAL_TOKEN=
